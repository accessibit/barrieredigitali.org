generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Type of the reported digital service.
enum ServiceType {
  WEBSITE
  APP
  DOCUMENT
  OTHER
}

/// Moderation status of a report.
enum ReportStatus {
  PENDING
  PUBLISHED
  REJECTED
}

/// A website, app, document or other digital service with published reports.
model Service {
  id             String      @id @default(cuid())
  slug           String      @unique
  name           String
  /// Normalized name (lowercase, without protocol or "www.") used for search.
  nameNormalized String      @map("name_normalized")
  type           ServiceType
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  reports        Report[]

  @@index([nameNormalized])
  @@map("services")
}

/// A report submitted by the public. It is linked to a service
/// and published only after review by the editorial team.
model Report {
  id            String       @id @default(cuid())
  serviceId     String?      @map("service_id")
  service       Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  submittedType ServiceType  @map("submitted_type")
  submittedName String       @map("submitted_name")
  description   String
  /// Optional, never published.
  email         String?
  status        ReportStatus @default(PENDING)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  /// Date shown to the public. Must be set when the report is published.
  publishedAt   DateTime?    @map("published_at")
  /// Daily HMAC of the sender's IP, used only to rate-limit submissions.
  /// The IP itself is never stored, and hashes from different days cannot be linked.
  ipHash        String?      @map("ip_hash")

  @@index([serviceId, status, publishedAt])
  @@index([status, createdAt])
  @@index([ipHash, createdAt])
  @@map("reports")
}
